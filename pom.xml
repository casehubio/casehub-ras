<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-parent</artifactId>
        <version>0.2-SNAPSHOT</version>
    </parent>

    <artifactId>casehub-ras-parent</artifactId>
    <version>0.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CaseHub RAS :: Parent</name>
    <description>Reticular Activating System — situational awareness and reactive case creation.
        Observes CloudEvent CDI events from platform stream modules, routes to pluggable Ganglion
        detection strategies, correlates composite events, and triggers case creation via
        casehub-engine when situation threshold is crossed. Platform stream infrastructure
        (Kafka, AMQP, webhook, Camel) lives in casehub-platform; RAS observes the CloudEvent
        CDI events they produce.</description>
    <url>https://github.com/casehubio/casehub-ras</url>

    <modules>
        <module>api</module>
        <module>runtime</module>
        <module>ras-drools</module>
        <module>drools-reliability</module>
        <module>ras-llm</module>
        <module>persistence-memory</module>
        <module>persistence-jpa</module>
        <module>testing</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jandex-maven-plugin.version>3.3.1</jandex-maven-plugin.version>
        <version.drools>10.1.0</version.drools>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- casehub-ras inter-module -->
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-drools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-persistence-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-persistence-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-testing</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ras-drools-reliability</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Drools CEP -->
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-model-codegen</artifactId>
                <version>${version.drools}</version>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-wiring-static</artifactId>
                <version>${version.drools}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-wiring-dynamic</artifactId>
                <version>${version.drools}</version>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-reliability-core</artifactId>
                <version>${version.drools}</version>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-reliability-h2mvstore</artifactId>
                <version>${version.drools}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>github</id>
            <name>casehubio GitHub Packages</name>
            <url>https://maven.pkg.github.com/casehubio/*</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/casehubio/casehub-ras</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <url>https://maven.pkg.github.com/casehubio/casehub-ras</url>
            <uniqueVersion>false</uniqueVersion>
        </snapshotRepository>
    </distributionManagement>

    <scm>
        <connection>scm:git:https://github.com/casehubio/casehub-ras.git</connection>
        <developerConnection>scm:git:https://github.com/casehubio/casehub-ras.git</developerConnection>
        <url>https://github.com/casehubio/casehub-ras</url>
    </scm>

</project>
